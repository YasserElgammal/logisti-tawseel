{
    "name": "yasser-elgammal/logisti-tawseel",
    "description": "Laravel package for Logisti / Tawseel delivery service provider APIs.",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "YasserElgammal\\LogistiTawseel\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "YasserElgammal\\LogistiTawseel\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.0",
        "illuminate/contracts": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/database": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/http": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/support": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0",
        "illuminate/validation": "^8.0|^9.0|^10.0|^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "orchestra/testbench": "^6.0|^7.0|^8.0|^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^9.5|^10.0|^11.0|^12.0"
    },
    "extra": {
        "laravel": {
            "providers": [
                "YasserElgammal\\LogistiTawseel\\LogistiServiceProvider"
            ],
            "aliases": {
                "Logisti": "YasserElgammal\\LogistiTawseel\\Facades\\Logisti"
            }
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
